{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill(pr-review)",
      "Agent(pr-review-verifier)",
      "Bash(node scripts/check-pr.mjs *)",
      "Bash(node scripts/validate-report.mjs *)",
      "PowerShell(node scripts/check-pr.mjs *)",
      "PowerShell(node scripts/validate-report.mjs *)",
      "Read(/data/**)",
      "Read(/references/**)",
      "Read(/scripts/**)",
      "Read(/out/**)",
      "Grep",
      "Glob",
      "Edit(/out/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(/golden/**)",
      "Read(/tests/**)",
      "Read(/docs/worker/runs/**)",
      "Edit(/data/**)",
      "Edit(/scripts/**)",
      "Edit(/references/**)",
      "Edit(/golden/**)",
      "Edit(/tests/**)",
      "Edit(/docs/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/run.ps1)",
      "Edit(/run.sh)",
      "Edit(/package.json)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node scripts/golden.mjs *)",
      "Bash(npm *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(node scripts/golden.mjs *)",
      "PowerShell(npm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/exact-command.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/search-scope.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
